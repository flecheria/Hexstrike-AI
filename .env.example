# =============================================================================
# HexStrike AI v6.0 - Compose Environment Configuration (.env)
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Container Build Configuration
# -----------------------------------------------------------------------------
# Use "Dockerfile" for Docker or "Containerfile" for Podman
CONTAINERFILE=Dockerfile
BASE_IMAGE=docker.io/library/python:3.11-slim-bookworm
HEXSTRIKE_IMAGE=hexstrike-ai:latest
HEXSTRIKE_CONTAINER_NAME=hexstrike-ai
HEXSTRIKE_RESTART_POLICY=unless-stopped

# Tool installation profile:
# Options: minimal, recon_network_scan, web_security, auth_password,
#          binary_forensics, cloud_security, full, manifest
TOOL_PROFILE=recon_network_scan

# Comma-separated extra tools to install at build time (e.g. "hydra,john,trivy")
EXTRA_TOOLS=

# Comma-separated tools to skip at build time (e.g. "amass")
EXCLUDE_TOOLS=

# -----------------------------------------------------------------------------
# 2. Runtime Server Configuration
# -----------------------------------------------------------------------------
HEXSTRIKE_BIND_IP=127.0.0.1
HEXSTRIKE_HOST_PORT=8888
HEXSTRIKE_HOST=0.0.0.0
HEXSTRIKE_PORT=8888
HEXSTRIKE_DEBUG=false

# Optional comma-separated tools to install dynamically on container startup
RUNTIME_EXTRA_TOOLS=

# -----------------------------------------------------------------------------
# 3. Persistent Volume Configuration
# -----------------------------------------------------------------------------
# Host directory mapped to /data inside the container
HEXSTRIKE_HOST_DATA_DIR=./hexstrike-data

# Internal container storage paths
HEXSTRIKE_DATA_DIR=/data
HEXSTRIKE_RESULTS_DIR=/data/results
HEXSTRIKE_FILES_DIR=/data/files
HEXSTRIKE_ENVS_DIR=/data/envs
HEXSTRIKE_LOG_FILE=/data/logs/hexstrike.log

# Optional volume mount flags (set to ":Z" on SELinux systems with Podman)
HEXSTRIKE_VOLUME_OPTS=

# -----------------------------------------------------------------------------
# 4. Dedicated Network Configuration
# -----------------------------------------------------------------------------
HEXSTRIKE_NETWORK_NAME=hexstrike-net
HEXSTRIKE_NETWORK_DRIVER=bridge
HEXSTRIKE_NETWORK_SUBNET=172.28.0.0/24
