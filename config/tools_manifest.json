{
  "version": "6.0.0",
  "description": "HexStrike AI Configurable Tool Manifest for Container Builds and MCP Tool Discovery",
  "default_profile": "recon_network_scan",
  "profiles": {
    "minimal": {
      "description": "Lightweight core subset for fast network scanning, DNS/subdomain recon, and HTTP probing",
      "categories": ["network", "reconnaissance", "scanning"]
    },
    "recon_network_scan": {
      "description": "Curated subset of the most important tools for Network Discovery, Reconnaissance, and Vulnerability/Web Scanning (Default)",
      "categories": ["network", "reconnaissance", "scanning"]
    },
    "web_security": {
      "description": "Recon/Network/Scan subset plus extended Web Application & API Security testing tools",
      "categories": ["network", "reconnaissance", "scanning", "web"]
    },
    "auth_password": {
      "description": "Recon/Network/Scan subset plus Authentication & Password auditing tools",
      "categories": ["network", "reconnaissance", "scanning", "auth"]
    },
    "binary_forensics": {
      "description": "Recon/Network/Scan subset plus Binary Analysis, Reverse Engineering, and Forensics/CTF tools",
      "categories": ["network", "reconnaissance", "scanning", "binary", "forensics"]
    },
    "cloud_security": {
      "description": "Recon/Network/Scan subset plus Cloud & Container Security auditing tools",
      "categories": ["network", "reconnaissance", "scanning", "cloud"]
    },
    "full": {
      "description": "Complete arsenal across all security domains",
      "categories": ["network", "reconnaissance", "scanning", "web", "auth", "binary", "forensics", "cloud"]
    }
  },
  "tools": {
    "nmap": {
      "binary": "nmap",
      "category": "network",
      "enabled": true,
      "essential": true,
      "profiles": ["minimal", "recon_network_scan", "web_security", "auth_password", "binary_forensics", "cloud_security", "full"],
      "description": "Network exploration, port scanning, OS/service version detection, and NSE script auditing",
      "mcp_tools": ["nmap_scan", "nmap_advanced_scan", "recon_domains", "investigate_domains", "batch_domain_tool"],
      "api_endpoints": ["/api/tools/nmap", "/api/tools/nmap-advanced"],
      "install": {
        "method": "apt",
        "package": "nmap"
      }
    },
    "masscan": {
      "binary": "masscan",
      "category": "network",
      "enabled": true,
      "essential": false,
      "profiles": ["recon_network_scan", "web_security", "auth_password", "binary_forensics", "cloud_security", "full"],
      "description": "High-speed Internet-scale TCP port scanner with banner grabbing",
      "mcp_tools": ["masscan_high_speed"],
      "api_endpoints": ["/api/tools/masscan"],
      "install": {
        "method": "apt",
        "package": "masscan"
      }
    },
    "rustscan": {
      "binary": "rustscan",
      "category": "network",
      "enabled": true,
      "essential": false,
      "profiles": ["recon_network_scan", "web_security", "full"],
      "description": "Ultra-fast asynchronous port discovery scanner with Nmap handoff",
      "mcp_tools": ["rustscan_fast_scan"],
      "api_endpoints": ["/api/tools/rustscan"],
      "install": {
        "method": "github_release",
        "repo": "RustScan/RustScan",
        "asset_patterns": {
          "amd64": ["x86_64-linux-rustscan.tar.gz.zip", "rustscan.*amd64.deb", "x86_64.*linux.*tar.gz"],
          "arm64": ["aarch64-linux-rustscan.tar.gz.zip", "aarch64.*linux.*tar.gz"]
        },
        "fallback": {
          "method": "apt",
          "package": "rustscan"
        }
      }
    },
